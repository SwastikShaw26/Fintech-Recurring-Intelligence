# Local generated outputs; keep documented synthetic fixtures in Git
data/processed/*
!data/processed/.gitkeep

# Frontend dependencies and build outputs
node_modules/
.next/
.vite/

# Local editor and operating-system files
.vscode/
.DS_Store
Thumbs.db
