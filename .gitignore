# ── Python ────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pytest_cache/

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.*
!.env.example
# Keep frontend/.env (contains only public VITE_API_URL, no secrets)
!frontend/.env

# ── Generated detector output (reproducible — re-run detector) ─
data/processed/*
!data/processed/.gitkeep

# ── Frontend ──────────────────────────────────────────────────
node_modules/
# Commit frontend/dist so FastAPI can serve the SPA without a build step
# Uncomment the line below ONLY if you prefer teammates to build locally:
# frontend/dist/
.next/
.vite/

# ── Editor / OS ───────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ── Build artefacts ───────────────────────────────────────────
build/
*.egg-info/
dist/
# Exception: keep frontend/dist (FastAPI static files)
!frontend/dist/
!frontend/dist/**
